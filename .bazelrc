# 既定ターゲット: RP2350 / Pico 2 W (CMake kit と同じ構成)
build --platforms=@pico-sdk//bazel/platform:rp2350
build --@pico-sdk//bazel/config:PICO_BOARD=pico2_w
build:rp2350_pico2_w --platforms=@pico-sdk//bazel/platform:rp2350
build:rp2350_pico2_w --@pico-sdk//bazel/config:PICO_BOARD=pico2_w
build:rp2350_pico2_w --//configs:board=rp2350_pico2_w
build:rp2350_pico2 --platforms=@pico-sdk//bazel/platform:rp2350
build:rp2350_pico2 --@pico-sdk//bazel/config:PICO_BOARD=pico2
build:rp2350_pico2 --//configs:board=rp2350_pico2
build:rp2040_pico_w --platforms=@pico-sdk//bazel/platform:rp2040
build:rp2040_pico_w --@pico-sdk//bazel/config:PICO_BOARD=pico_w
build:rp2040_pico_w --//configs:board=rp2040_pico_w
build:rp2040_pico_w --copt=-DSHIZUKU_RP2040=1
build:rp2040_pico_w --cxxopt=-DSHIZUKU_RP2040=1
build:rp2040_xiao --platforms=@pico-sdk//bazel/platform:rp2040
build:rp2040_xiao --@pico-sdk//bazel/config:PICO_BOARD=seeed_xiao_rp2040
build:rp2040_xiao --//configs:board=rp2040_xiao
build:rp2040_xiao --copt=-DSHIZUKU_RP2040=1
build:rp2040_xiao --cxxopt=-DSHIZUKU_RP2040=1
build:rp2040_pico --platforms=@pico-sdk//bazel/platform:rp2040
build:rp2040_pico --@pico-sdk//bazel/config:PICO_BOARD=pico
build:rp2040_pico --//configs:board=rp2040_pico
build:rp2040_pico --copt=-DSHIZUKU_RP2040=1
build:rp2040_pico --cxxopt=-DSHIZUKU_RP2040=1
# Backwards-compatible aliases for the previous two profile names.
build:rp2350 --config=rp2350_pico2_w
build:rp2040 --config=rp2040_pico_w
# ★pico_stdio_usb は使わない。CDC 1 本前提で記述子も差し替えられないため、USB は
#   自前で持つ (modules/pico_sdk_support/objects/usb_cdc.cpp、D42)。
#   診断 = CDC0 / GDB = CDC1 に分けるのが目的。
build --@pico-sdk//bazel/config:PICO_STDIO_USB=False
build --@pico-sdk//bazel/config:PICO_TINYUSB_CONFIG=//modules/pico_sdk_support:tusb_config
# BTstack is only linked by the W-board selects in modules/pico_sdk_support/BUILD.bazel.
build --@pico-sdk//bazel/config:PICO_BTSTACK_CONFIG=//modules/pico_sdk_support:btstack_config
# btstack_config enables LE peripheral support; enable the SDK BLE target define too.
build --@pico-sdk//bazel/config:PICO_BT_ENABLE_BLE=True
# CYW43 の分周比と PIO プログラムを clk_sys から導出して SDK 内部まで届かせる。
# ★値は configs/cyw43_clock.bzl が決める (直書きしない理由はそこに書いてある)。
build --@pico-sdk//bazel/config:PICO_CONFIG_EXTRA_HEADER=//configs:pico_extra_config

# カーネルは C++23 (cxxopt は C++ 翻訳単位にのみ効く)
build --cxxopt=-std=c++23

# ★行番号を必ず入れる。DWARF は**焼くものには入らない** (uf2 に載るのは loadable な
#   セクションだけ) ので、デバイス側の費用はゼロ。入れていなかったせいで、フォールトの
#   pc を addr2line に食わせても `unprivileged.cpp:?` と関数名しか出ず、行が分からな
#   かった。ステップ実行にも要る。
build --copt=-g3
# ★Bazel の既定は --strip=sometimes = **fastbuild では剥がす**。-g3 を足しただけでは
#   リンクで消えるので、剥がさないと明示する。焼くものには載らないので害は無い。
build --strip=never

# fastbuild の -O0 だと svc ラッパの inline asm (入力 5 + 出力 2 + r0-r3/ip/lr
# clobber) がレジスタ割付不能になる。CMake の Debug (-Og) と揃える。
build --copt=-Og

# V3 interface groundwork on V2; software-SVC and explicit PRIMASK envelope maxima.
build:v3gw --copt=-DSHIZUKU_KERNEL_SERVICE_PROFILE=1

# UF2 生成: 公式の uf2_aspect は picotool をソースビルドするが、Apple Silicon ホスト
# では pico-sdk 2.2.0 の src/host/hardware_sync が clang builtin (__sev/__wfi/__wfe) と
# 衝突してビルドできない (2026-08-19 実測、2026-10-12 に bazel_dep picotool 2.2.0 でも再現)。
# そこで //firmware:shizuku_uf2 (genrule) は、macOS ホストではローカルの
# /opt/picotool、それ以外 (main-lxc などの Linux worker) では Bazel 製 picotool を使う。
# ホスト OS の判定は --enable_platform_specific_config の build:macos で行う。
common --enable_platform_specific_config
build:macos --define=picotool=host
# build --aspects=@pico-sdk//tools:uf2_aspect.bzl%pico_uf2_aspect
# build --output_groups=+pico_uf2_files

# ---------------------------------------------------------------------------
# ESP32-C6 (RV32) — archive pre-init entry を含む build。
#   bazelisk build --config=esp32c6 //modules/esp_idf_support/firmware:esp32c6
# ★start_cpu0 は diag hook 後 M-only kernel/bootstrap pilot を呼ぶ。timer/PMP と実機到達は未検証。
# ★IDF は自動で探さない。事前に IDF_PATH / IDF_TOOLS_PATH を export しておくこと
#   (欠けていれば //modules/esp_idf_support/firmware:esp32c6 は理由を出して失敗する)。
# ---------------------------------------------------------------------------
build:esp32c6 --platforms=//toolchains/rv32_esp:esp32c6
build:esp32c6 --//configs:board=esp32_c6
build:esp32c6 --copt=-DSHIZUKU_C6_SKELETON_PERMITTED=1
build:esp32c6 --action_env=IDF_PATH
build:esp32c6 --action_env=IDF_TOOLS_PATH
build:esp32c6 --action_env=PATH
# カーネル (カーネル本体・カーネルオブジェクト・trap 入口) だけ -O2。オブジェクト側・selftest・board・
# ESP-IDF 側は -Og のまま (上の `--copt=-Og` の後に付くので後勝ち)。ARM (RP) は変えない。
# 戻すときは `--per_file_copt=^source/(kernel|kernel_object|cpu_manager)/@-Og` を足す。
build:esp32c6 --per_file_copt=^source/(kernel|kernel_object|cpu_manager)/,^chips/esp32_c6/trap\.cpp$@-O2
# C6 のカーネルは既定で部分リンク LTO。比較時は esp32c6 の後に kernel_no_lto を指定する。
build:esp32c6 --config=kernel_lto
# ESP32-C6 U-mode + PMP 無効化オプション (既定は enabled)
build:c6_umode_off --//configs:c6_umode=disabled

# ---------------------------------------------------------------------------
# ESP32-C5 (RV32, CLIC) — C6 と同じ rv32_esp ツールチェーン / platform。board だけが違う。
#   bazelisk build --config=esp32c5 //modules/esp_idf_support/firmware:esp32c5
# ★IDF は C6 と同じく IDF_PATH / IDF_TOOLS_PATH を事前に export しておくこと。
# ---------------------------------------------------------------------------
build:esp32c5 --platforms=//toolchains/rv32_esp:esp32c6
build:esp32c5 --//configs:board=esp32_c5
build:esp32c5 --copt=-DSHIZUKU_C5_SKELETON_PERMITTED=1
build:esp32c5 --action_env=IDF_PATH
build:esp32c5 --action_env=IDF_TOOLS_PATH
build:esp32c5 --action_env=PATH
# C6 と同じ: カーネルだけ -O2 (理由と戻し方は esp32c6 の節)。
build:esp32c5 --per_file_copt=^source/(kernel|kernel_object|cpu_manager)/,^chips/esp32_c5/trap\.cpp$@-O2

# Separate C5 BLE controller-init image. The ordinary esp32c5 profile and
# selftest firmware remain unchanged.
build:esp32c5_ble --config=esp32c5
build:esp32c5_ble --//configs:ble_profile=controller_init
build:esp32c5_ble --copt=-DSHIZUKU_C5_BLE=1
build:esp32c5_ble --copt=-DSHIZUKU_ESP_BLE=1

# カーネル .a を作る段階で 1 回だけ LTO (GCC の部分リンク。modules/esp_idf_support/firmware/kernel_lto.sh)。
#   bazelisk build --config=esp32c6 --config=kernel_lto //modules/esp_idf_support/firmware:esp32c6
# カーネルの .o だけ `-flto -ffat-lto-objects` (fat なので LTO の段を通さなくても使える)。
# -O2 は esp32c6 / esp32c5 の per_file_copt が付ける。
build:kernel_lto --define=shizuku_kernel_lto=1
build:kernel_lto --per_file_copt=^source/(kernel|kernel_object|cpu_manager)/,^chips/esp32_c[56]/trap\.cpp$@-flto,-ffat-lto-objects
build:kernel_no_lto --define=shizuku_kernel_lto=0
build:kernel_no_lto --per_file_copt=^source/(kernel|kernel_object|cpu_manager)/,^chips/esp32_c[56]/trap\.cpp$@-fno-lto

# C6 BLE controller-init firmware uses the same isolated IDF BLE profile.
build:esp32c6_ble --config=esp32c6
build:esp32c6_ble --//configs:ble_profile=controller_init
build:esp32c6_ble --copt=-DSHIZUKU_ESP_BLE=1
test --platforms=@platforms//host

# 試験的な遅延退避 (--config=abi_lazy_save、既定は無効)
try-import %workspace%/tools/abi_lazy_save.bazelrc
