load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//:defs.bzl", "shizuku_firmware", "shizuku_object", "shizuku_sketch", "shizuku_sketch_object")

package(default_visibility = ["//visibility:public"])

# 1. 独立した shizuku_object
shizuku_object(
    name = "sample_obj",
    srcs = ["sample_object.cpp"],
    hdrs = ["sample_object.hpp"],
    deps = ["//:core_headers"],
)

# 2. 独立した shizuku_sketch_object (2個のスケッチ共存検証)
shizuku_sketch_object(
    name = "sample_sketch_obj",
    srcs = ["sample_sketch.cpp"],
)

shizuku_sketch_object(
    name = "sample_sketch_obj_second",
    srcs = ["sample_sketch_second.cpp"],
    setup_fn = "setup_second",
    loop_fn = "loop_second",
)

# 3. 複数オブジェクト（object + 2 sketches）を合成したファームウェア
shizuku_firmware(
    name = "sample_fw",
    target = "esp32c6",
    objects = [
        ":sample_obj",
        ":sample_sketch_obj",
        ":sample_sketch_obj_second",
    ],
    # NOTE: Interim composition loader supports root-only parent (parent_id == 1).
    # Full nested parent authority derivation is a pending specification item.
    # All objects in this sample agree with the root-only interim loader.
    parents = {
        "sample_obj": "root",
        "sample_sketch_obj": "root",
        "sample_sketch_obj_second": "root",
    },
    privileged_names = [
        "sample_obj",
    ],
)

# 4. 単一スケッチ直行ファームウェア
shizuku_sketch(
    name = "direct_sketch_fw",
    srcs = ["sample_sketch.cpp"],
    target = "esp32c6",
)

# 5. ローダーポリシー & Yield 語彙ホスト検証テスト
cc_test(
    name = "test_manifest_loader",
    srcs = [
        "test_manifest_loader.cpp",
    ],
    deps = [
        "//:firmware_loader",
        "//:core_headers",
    ],
)
