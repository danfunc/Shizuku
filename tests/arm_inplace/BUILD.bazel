[
    cc_library(
        name = "r7_frame_probe_" + opt,
        srcs = ["r7_frame_probe.cpp"],
        copts = ["-std=c++20", "-fno-omit-frame-pointer", "-" + opt],
        tags = ["manual"],
        target_compatible_with = select({
            "//configs:rp2350": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = ["//:internal_headers"],
    )
    for opt in ["Og", "O2"]
]

