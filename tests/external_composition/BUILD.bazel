load("@shizuku//:defs.bzl", "shizuku_firmware", "shizuku_object", "shizuku_sketch_object")

package(default_visibility = ["//visibility:public"])

# One compile unit is reused in two separate firmware compositions.
shizuku_object(
    name = "shared_sensor",
    srcs = ["shared_sensor.cpp"],
)

shizuku_sketch_object(
    name = "status_sketch",
    srcs = ["status_sketch.cpp"],
)

shizuku_sketch_object(
    name = "status_sketch_second",
    srcs = ["status_sketch_second.cpp"],
    setup_fn = "setup_second",
    loop_fn = "loop_second",
)

# Each firmware has a composition-local ID table. The same shared object is
# compiled once and linked into both; each archive must define each ID once.
shizuku_firmware(
    name = "consumer_alpha",
    target = "esp32c6",
    objects = [":shared_sensor", ":status_sketch"],
)

shizuku_firmware(
    name = "consumer_beta",
    target = "esp32c6",
    objects = [":shared_sensor", ":status_sketch_second"],
)
