load("@rules_cc//cc:defs.bzl", "cc_library")
load("//:defs.bzl", "shizuku_firmware", "shizuku_object", "shizuku_sketch", "shizuku_sketch_object")
load("//configs:rp_firmware.bzl", "rp_firmware", "rp_objects_archive", "rp_sketch")

package(default_visibility = ["//visibility:public"])

# 1. 独立した shizuku_object
shizuku_object(
    name = "sample_rp_obj",
    srcs = ["sample_rp_object.cpp"],
    hdrs = ["sample_rp_object.hpp"],
)

# 2. 独立した shizuku_sketch_object (2個のスケッチ共存検証)
shizuku_sketch_object(
    name = "sample_rp_sketch_obj",
    srcs = ["sample_rp_sketch.cpp"],
)

shizuku_sketch_object(
    name = "sample_rp_sketch_obj_second",
    srcs = ["sample_rp_sketch_second.cpp"],
    setup_fn = "setup_second",
    loop_fn = "loop_second",
)

# 3. 複数オブジェクト（object + 2 sketches）を合成した SDK-free アーカイブ
rp_objects_archive(
    name = "sample_rp_fw_archive",
    target = "rp2040",
    objects = [
        ":sample_rp_obj",
        ":sample_rp_sketch_obj",
        ":sample_rp_sketch_obj_second",
    ],
    parents = {
        "sample_rp_obj": "root",
        "sample_rp_sketch_obj": "root",
        "sample_rp_sketch_obj_second": "root",
    },
    privileged_names = [
        "sample_rp_obj",
    ],
)

# 4. 完全な RP2040 Pico SDK UF2 ファームウェア (kernel + bootstrap + objects + CMake final link)
# pico_sdk_path is portable; passed through env or explicit attr, never hardcoded.
rp_firmware(
    name = "sample_rp_firmware",
    target = "rp2040",
    board = "pico",
    objects = [
        ":sample_rp_obj",
        ":sample_rp_sketch_obj",
        ":sample_rp_sketch_obj_second",
    ],
    parents = {
        "sample_rp_obj": "root",
        "sample_rp_sketch_obj": "root",
        "sample_rp_sketch_obj_second": "root",
    },
    privileged_names = [
        "sample_rp_obj",
    ],
)

# 5. 単一スケッチ糖衣マクロによる UF2 生成 (rp_sketch)
rp_sketch(
    name = "sample_rp_single_sketch",
    srcs = ["sample_rp_sketch.cpp"],
    target = "rp2040",
    board = "pico",
)

# 6. shizuku_firmware 直接呼び出しによる RP2040 UF2 生成 (unified API)
shizuku_firmware(
    name = "sample_shizuku_rp_firmware",
    target = "rp2040",
    board = "pico",
    objects = [
        ":sample_rp_obj",
        ":sample_rp_sketch_obj",
    ],
    parents = {
        "sample_rp_obj": "root",
        "sample_rp_sketch_obj": "root",
    },
    privileged_names = [
        "sample_rp_obj",
    ],
)

# 7. shizuku_sketch 直接呼び出しによる RP2040 UF2 生成 (unified single-sketch convenience flow)
shizuku_sketch(
    name = "sample_shizuku_rp_single_sketch",
    srcs = ["sample_rp_sketch.cpp"],
    target = "rp2040",
    board = "pico",
)
