# 実行ファイルを作るのはここだけ (BUILD.bazel の冒頭を参照)。
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@pico-sdk//bazel/toolchain:objcopy.bzl", "objcopy_to_bin")


# 書き込み: bazelisk run //firmware:flash (ビルドしてから焼く)。
sh_binary(
    name = "flash",
    srcs = ["//tools:flash.sh"],
    # ★場所を引数で渡す。スクリプト側の既定パスに頼ると、ターゲットを動かした
    #   ときに黙って古い uf2 を焼く (実際に //:shizuku_uf2 -> //firmware: へ
    #   移したときパスが取り残されていた)。
    args = ["$(location :shizuku_uf2)"],
    data = [":shizuku_uf2"],
)

# ELF → UF2 変換。
# macOS (Apple Silicon) では pico-sdk 2.2.0 の src/host/hardware_sync が clang builtin
# (__sev/__wfi/__wfe) と衝突し、Bazel 製 picotool をビルドできない (2026-08-19 実測、
# 2026-10-12 再確認)。そのため macOS は --define=picotool=host (.bazelrc で設定) で
# ホストの /opt/picotool を使う (非 hermetic)。Linux 等の既定は bazel_dep の picotool。
# tags は select できないので、両方とも no-sandbox にしている (Bazel 製側は入力が全て
# 宣言済みなので、sandbox を外しても結果は変わらない)。
config_setting(
    name = "host_picotool",
    define_values = {"picotool": "host"},
)

genrule(
    name = "shizuku_uf2",
    srcs = [":shizuku"],
    outs = ["shizuku.uf2"],
    cmd = select({
        ":host_picotool": "/opt/picotool/bin/picotool uf2 convert -t elf $(location :shizuku) $@",
        "//conditions:default": "$(location @picotool//:picotool) uf2 convert -t elf $(location :shizuku) $@",
    }),
    tags = ["no-sandbox"],
    tools = select({
        ":host_picotool": [],
        "//conditions:default": ["@picotool//:picotool"],
    }),
)

# 自己テストを省略する OTA 検証用ビルド。既定プロファイルは変更しない。
config_setting(
    name = "skip_selftest",
    define_values = {"skip_selftest": "true"},
)

# 生バイナリ (選択中の pico-sdk C++ toolchain の objcopy)。OTA 転送用。
objcopy_to_bin(
    name = "shizuku_bin",
    src = ":shizuku",
    out = "shizuku.bin",
)

config_setting(
    name = "build_id_v1",
    define_values = {"build_id": "v1"},
)

config_setting(
    name = "build_id_v2",
    define_values = {"build_id": "v2"},
)


cc_binary(
    name = "shizuku",
    srcs = ["main.cpp"],
    local_defines = select({
        ":build_id_v2": ["SHIZUKU_BUILD_ID=\\\"v2\\\""],
        ":build_id_v1": ["SHIZUKU_BUILD_ID=\\\"v1\\\""],
        "//conditions:default": ["SHIZUKU_BUILD_ID=\\\"v1\\\""],
    }) + select({
        "//configs:flashfs_only_selftest": ["SHIZUKU_FLASHFS_ONLY=1"],
        "//conditions:default": [],
    }) + select({
        ":skip_selftest": ["SHIZUKU_SKIP_SELFTEST=1"],
        "//conditions:default": [],
    }) + select({
        "//configs:boot_log_wait_enabled": ["SHIZUKU_BOOT_LOG_WAIT=1"],
        "//conditions:default": [],
    }) + select({
        "//configs:crash_record_enabled": [
            "SHIZUKU_CRASH_RECORD=1",
            "SHIZUKU_BOOT_LOG_WAIT=1",
        ],
        "//conditions:default": [],
    }),
    additional_linker_inputs = [
        "rp2040_flash_limit.ld",
        "rp2350_flash_limit.ld",
    ],
    linkopts = select({
        "//configs:rp2040": ["-Wl,-T,$(location :rp2040_flash_limit.ld)"],
        "//conditions:default": ["-Wl,-T,$(location :rp2350_flash_limit.ld)"],
    }) + select({
        "//configs:rp2040_pico_w": [
            "-Wl,--wrap=pico_flash_bank_instance",
        ],
        "//conditions:default": [],
    }) + select({
        "//configs:rp2040_pico_w_ram_tlv": [
            "-Wl,--wrap=btstack_tlv_flash_bank_init_instance",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//:internal_headers",
        "//:apps",
        "//:kernel_object",
        "//configs:config",
        "//modules/pico_sdk_support",
        "@pico-sdk//src/rp2_common/hardware_watchdog:hardware_watchdog",
        "@pico-sdk//src/rp2_common/pico_bootrom",
        "@pico-sdk//src/rp2_common/pico_multicore",
        "@pico-sdk//src/rp2_common/pico_stdlib",
    ] + select({
        ":skip_selftest": [],
        "//conditions:default": ["//:selftest"],
    }) + select({
        "//configs:cyw43": [
            "//modules/pico_sdk_support:ble_uart",
            "//modules/pico_sdk_support:ota",
        ],
        "//conditions:default": [],
    }),
)

# ESP32-C5: //modules/esp_idf_support/firmware:esp32c5 への alias。
alias(
    name = "esp32c5",
    actual = "//modules/esp_idf_support/firmware:esp32c5",
    visibility = ["//visibility:public"],
)

# ESP32-C6: 移動後ターゲット //modules/esp_idf_support/firmware:esp32c6 への互換 alias。
# 従来のビルドコマンド (bazelisk build --config=esp32c6 //firmware:esp32c6) を維持する。
alias(
    name = "esp32c6",
    actual = "//modules/esp_idf_support/firmware:esp32c6",
    visibility = ["//visibility:public"],
)
