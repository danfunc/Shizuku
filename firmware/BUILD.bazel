# 実行ファイルを作るのはここだけ (BUILD.bazel の冒頭を参照)。
load("@rules_cc//cc:defs.bzl", "cc_binary")

# 書き込み: bazelisk run //firmware:flash (ビルドしてから焼く)。
sh_binary(
    name = "flash",
    srcs = ["//tools:flash.sh"],
    # ★場所を引数で渡す。スクリプト側の既定パスに頼ると、ターゲットを動かした
    #   ときに黙って古い uf2 を焼く (実際に //:shizuku_uf2 -> //firmware: へ
    #   移したときパスが取り残されていた)。
    args = ["$(location :shizuku_uf2)"],
    data = [":shizuku_uf2"],
)

# ローカルの picotool で ELF → UF2 変換 (.bazelrc のコメント参照。非 hermetic)。
genrule(
    name = "shizuku_uf2",
    srcs = [":shizuku"],
    outs = ["shizuku.uf2"],
    cmd = "/opt/picotool/bin/picotool uf2 convert -t elf $(location :shizuku) $@",
    tags = ["no-sandbox"],
)

cc_binary(
    name = "shizuku",
    srcs = ["main.cpp"],
    additional_linker_inputs = [
        "rp2040_flash_limit.ld",
        "rp2350_flash_limit.ld",
    ],
    linkopts = select({
        "//configs:rp2040": ["-Wl,-T,$(location :rp2040_flash_limit.ld)"],
        "//conditions:default": ["-Wl,-T,$(location :rp2350_flash_limit.ld)"],
    }),
    deps = [
        "//:internal_headers",
        "//:apps",
        "//:kernel_object",
        "//:selftest",
        "//configs:config",
        "//modules/pico_sdk_support",
        "@pico-sdk//src/rp2_common/hardware_watchdog:hardware_watchdog",
        "@pico-sdk//src/rp2_common/pico_bootrom",
        "@pico-sdk//src/rp2_common/pico_stdlib",
    ],
)

# ---------------------------------------------------------------------------
# ESP32-C6: Bazel が作る libshizuku_kernel.a を ESP-IDF v6.1 の最終リンクへ渡し、
# .bin を出す **compile/link-only** のターゲット (idf.py build の薄いラッパ)。
#   bazelisk build --config=esp32c6 //firmware:esp32c6
# ★起動してもカーネルは動かない。main/shizuku_boot.c の start_cpu0 は即トラップ
#   (FreeRTOS スケジューラも始めない)。実機・実行時の動作は未検証。
# ★IDF のサンドボックス外ツールを使うので no-sandbox。IDF_PATH / IDF_TOOLS_PATH 必須。
# ---------------------------------------------------------------------------
genrule(
    name = "esp32c6",
    srcs = [
        "//:shizuku_kernel",
        ":esp32c6_project",
    ],
    outs = ["shizuku_esp32c6.bin"],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel); do case $$f in *libshizuku_kernel.a) ARCHIVE=$$f;; esac; done;" +
          " $(location esp32c6/build.sh) $$ARCHIVE $@ esp-15.2.0_20251204",
    tools = ["esp32c6/build.sh"],
    tags = [
        "local",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

filegroup(
    name = "esp32c6_project",
    srcs = glob(["esp32c6/CMakeLists.txt", "esp32c6/sdkconfig.defaults", "esp32c6/main/*"]),
)
