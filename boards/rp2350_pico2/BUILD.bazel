load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "boot_diag_record",
    hdrs = ["boot_diag_record.hpp"],
)

cc_test(
    name = "boot_diag_record_test",
    srcs = ["boot_diag_record_test.cpp"],
    deps = [":boot_diag_record"],
)

cc_library(
    name = "boot_diag",
    srcs = ["boot_diag.cpp"],
    hdrs = ["boot_diag.hpp"],
    copts = ["-mgeneral-regs-only", "-fno-builtin"],
    alwayslink = True,
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2350"],
    deps = [
        ":boot_diag_record",
        "//chips/rp2350:headers",
        "@pico-sdk//src/rp2_common/hardware_watchdog",
        "@pico-sdk//src/rp2_common/pico_runtime_init",
        "@pico-sdk//src/rp2_common/pico_stdlib",
    ],
)

cc_library(
    name = "headers",
    hdrs = ["rp2350_pico2.hpp", "boot_diag.hpp"],
    includes = ["."],
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2350"],
    deps = [
        "//arch/armv8m:headers",
        "//chips/rp2350:headers",
        "//:internal_headers",
    ],
)

cc_library(
    name = "board",
    srcs = ["board.cpp"],
    alwayslink = True,
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2350"],
    deps = [
        ":headers",
        "//arch/armv8m:ctx",
        "//:kernel",
        "//configs:config",
        "//modules/pico_sdk_support/objects:usb_cdc",
        "@pico-sdk//bazel/config:PICO_TINYUSB_LIB",
        "@pico-sdk//src/rp2_common/hardware_dma",
        "@pico-sdk//src/rp2_common/hardware_exception",
        "@pico-sdk//src/rp2_common/hardware_sync",
        "@pico-sdk//src/rp2_common/hardware_timer",
        "@pico-sdk//src/rp2_common/hardware_watchdog",
        "@pico-sdk//src/rp2_common/pico_multicore",
        "@pico-sdk//src/rp2_common/pico_stdlib",
    ] + select({
        "//configs:rp2350_copy_to_ram_enabled": [":boot_diag"],
        "//conditions:default": [],
    }),
)
