load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# ESP32-C6 の board 実装。カーネルのリンクに入る部品は trap.cpp と同じく
# //:shizuku_kernel の srcs から直接引く (archive の順序に依存させないため)。
exports_files([
    "esp32_c6.hpp",
    "board_esp32_c6.cpp",
    "board_esp32_c6_stubs.cpp",
    "led_gpio.hpp",
    "led_object.hpp",
])

cc_library(
    name = "headers",
    hdrs = ["esp32_c6.hpp"],
    includes = ["."],
    deps = [
        "//:internal_headers",
        "//chips/esp32_c6:headers",
    ],
)

# ユーザー LED の GPIO 操作 (レジスタ値と Mmio 版の書込み)。実機の board と試験の両方から使う。
cc_library(
    name = "led_gpio",
    hdrs = ["led_gpio.hpp"],
)

# C6 のユーザー LED オブジェクト (WRITE の口は led_blink と同じ ABI)。
cc_library(
    name = "led_object",
    hdrs = ["led_object.hpp"],
    deps = [
        ":led_gpio",
        "//modules/led_blink:led_abi",
    ],
)
