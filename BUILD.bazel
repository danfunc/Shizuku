# ===========================================================================
#  Shizuku — カーネルは**ライブラリ**として提供する
# ===========================================================================
#  実行ファイルを作るのは //firmware だけ。カーネル / カーネルオブジェクト /
#  自己テストはそれぞれ別のライブラリで、「どれを繋いで何を走らせるか」を決めるのは
#  合成 (firmware/main.cpp) の仕事。XNO 側は同じ 3 つを引いて**自分の合成**を書く。
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# RISC-V のカーネルは gp / tp に依存しない (2026-10-22 決定、.handoff/v3-design-notes.md §4)。
# method call の入口ではレジスタを callee のものへ入れ直さず、gp / tp は callee 側の入口 stub が
# 入れる。カーネルが gp 相対を使うと caller の gp (オブジェクトごとに違う) を踏んで壊れるので、
# 構造で保証する: -mno-relax ならコンパイラもリンカも gp 相対 (R_RISCV_RELAX) を作らない。
# ARM には効かせない。ESP-IDF 側と selftest / オブジェクトの翻訳単位は別アーカイブ・別ライブラリ。
# ★//:shizuku_kernel* は selftest ソースを同じ .a に抱えるため、それらにも掛かる
#   (genrule が .a を 1 本しか受け取らない制約)。
RV_KERNEL_COPTS = select({
    "@platforms//cpu:riscv32": ["-mno-relax"],
    "//conditions:default": [],
})

exports_files([
    "source/kernel_object/handler.cpp",
    "source/selftest/call_cost.cpp",
])

# オブジェクト番号の生成。★**CMake とまったく同じスクリプトを呼ぶ** —
# 番号を振る規則を 2 つ持つと、片方だけ直して番号がずれる。名前の一覧も
# objects.list を共有するので、二重に書く場所がどこにも無い (D28)。
genrule(
    name = "object_ids_hpp",
    srcs = [
        "//tools:object_ids.hpp.in",
        "source/apps/objects.list",
        "source/selftest/objects.list",
        "//modules/pico_sdk_support:objects.list",
    ],
    outs = ["generated_object_ids/shizuku/object_ids.hpp"],
    cmd = "python3 $(location //tools:gen_object_ids.py)" +
          " --template $(location //tools:object_ids.hpp.in)" +
          " --out $@ --limit 72" +
          " $(location source/apps/objects.list)" +
          " $(location source/selftest/objects.list)" +
          " $(location //modules/pico_sdk_support:objects.list)",
    tools = ["//tools:gen_object_ids.py"],
)

cc_library(
    name = "object_ids",
    hdrs = [":object_ids_hpp"],
    includes = ["generated_object_ids"],
    visibility = ["//visibility:public"],
)

# ISA 非依存のカーネルヘッダ (CMake の Shizuku_internal_HEADERS に相当)
filegroup(
    name = "c6_test_headers",
    srcs = glob(["internal_headers/**/*.hpp"]),
    visibility = ["//visibility:public"],
)

# Headers included by the IDF-side C5 compatibility implementation.
filegroup(
    name = "esp_idf_support_headers",
    srcs = ["internal_headers/shizuku/object_api.hpp"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "internal_headers",
    hdrs = glob(["internal_headers/**/*.hpp"]),
    includes = ["internal_headers"],
    defines = select({
        "//configs:c6_umode_ledger_enabled": ["SHIZUKU_LEAN_LEDGER=1"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":object_ids"],
)

# arch (ISA 層) が実際に include する kernel ヘッダだけ。internal_headers と違い
# :object_ids (objects.list = modules/pico_sdk_support の入力) に依存しない。
# 閉包は arch/armv6m/armv6m.hpp と arch/armv8m/armv8m.hpp から静的に確認済み。
filegroup(
    name = "arch_internal_header_files",
    srcs = [
        "internal_headers/shizuku/concepts/arch.hpp",
        "internal_headers/shizuku/kernel_abi.hpp",
        "internal_headers/shizuku/rv32_abi.hpp",
        "internal_headers/shizuku/service_profile.hpp",
    ],
)

cc_library(
    name = "arch_headers",
    hdrs = [":arch_internal_header_files"],
    includes = ["internal_headers"],
    visibility = ["//visibility:public"],
)

# Host unit test for the real dispatcher implementation. Compile the two
# implementation units separately and force the same C6 test config into each.
cc_test(
    name = "dispatcher_v1_test",
    srcs = [
        "source/kernel/dispatch.cpp",
        "source/kernel/thread.cpp",
        "source/selftest/test_dispatcher_v1.cpp",
        "source/selftest/test_dispatcher_v1_config.hpp",
    ],
    copts = [
        "-std=c++20",
        "-include",
        "source/selftest/test_dispatcher_v1_config.hpp",
    ],
    local_defines = ["SHIZUKU_C6_SKELETON_PERMITTED=1"],
    deps = [
        ":internal_headers",
        "//boards/esp32_c6:headers",
        "//chips/esp32_c6:headers",
        "//configs:config",
    ],
)

# The kernel-resident return ledger must preserve dispatch/call behavior and reject invalid unwinds.
cc_test(
    name = "dispatcher_v1_lean_ledger_test",
    srcs = [
        "source/kernel/dispatch.cpp",
        "source/kernel/thread.cpp",
        "source/selftest/test_dispatcher_v1.cpp",
        "source/selftest/test_dispatcher_v1_config.hpp",
    ],
    copts = [
        "-std=c++20",
        "-include",
        "source/selftest/test_dispatcher_v1_config.hpp",
    ],
    defines = ["SHIZUKU_LEAN_LEDGER=1"],
    local_defines = ["SHIZUKU_C6_SKELETON_PERMITTED=1"],
    deps = [
        ":internal_headers",
        "//boards/esp32_c6:headers",
        "//chips/esp32_c6:headers",
        "//configs:config",
    ],
)

# カーネル本体のソース。//:kernel と //:shizuku_kernel (ESP32-C6 の .a) で共有する。
KERNEL_SRCS = [
    "source/cpu_manager/init.cpp",
    "source/kernel/dispatch.cpp",
    "source/kernel/init.cpp",
    "source/kernel/thread.cpp",
]

# カーネル = 機構だけの層。★資源を持たない (スレッドの記憶も貸してもらう) ので、
# 実体としてはライブラリ以外になりようがない。
cc_library(
    name = "kernel",
    copts = RV_KERNEL_COPTS,
    srcs = KERNEL_SRCS + [
        "source/kernel/services.cpp",
        "source/kernel/service_profile.cpp",
    ],
    visibility = ["//visibility:public"],
    # ★ポート (//modules/pico_sdk_support) を名指ししない。arch / board は
    #   //configs:config が型として注入する (configs/kit.bzl)。
    deps = [
        ":internal_headers",
        "//configs:config",
    ],
)

KERNEL_OBJECT_SRCS = [
    "source/kernel_object/handler.cpp",
    "source/kernel_object/memory.cpp",
]

# カーネルオブジェクト = 方針の層。★カーネルとは別のライブラリにする。分けること
# 自体が D1 (カーネルはオブジェクトを知らない) の検算になる — 依存は一方向しかない。
cc_library(
    name = "kernel_object",
    copts = RV_KERNEL_COPTS,
    srcs = KERNEL_OBJECT_SRCS,
    visibility = ["//visibility:public"],
    deps = [":kernel"] + select({
        "//configs:crash_record_enabled": [
            "//modules/pico_sdk_support/objects:usb_cdc",
        ],
        "//conditions:default": [],
    }),
    local_defines = select({
        "//configs:crash_record_enabled": [
            "SHIZUKU_CRASH_RECORD=1",
            "SHIZUKU_BOOT_LOG_WAIT=1",
        ],
        "//conditions:default": [],
    }),
)

# C5 / C6 で成立可能な selftest の 5 つのサブセット
C5_SELFTEST_SRCS = [
    "source/selftest/call_ladder.cpp",
    "source/selftest/compat_premise_probe.cpp",
    "source/selftest/handler_binding.cpp",
    "source/selftest/memory_ladder.cpp",
    "source/selftest/stream_ladder.cpp",
    "source/selftest/thread_ladder.cpp",
]

C6_SELFTEST_SRCS = C5_SELFTEST_SRCS + select({
    "//configs:c6_umode_enabled": ["source/selftest/c6_stage1_safety.cpp"],
    "//conditions:default": [],
})

exports_files(
    ["source/selftest/c6_stage1_safety.cpp"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "c6_selftest",
    srcs = C6_SELFTEST_SRCS,
    defines = select({
        "//configs:c6_umode_enabled": ["SHIZUKU_C6_UMODE=1"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":internal_headers",
        ":kernel_object",
        "//chips/esp32_c6:headers",
    ],
)

# 自己テストは「カーネルの一部」ではなく、カーネルを使うオブジェクトの集合。
cc_library(
    name = "selftest",
    srcs = [
        "source/selftest/call_cost.cpp",
        "source/selftest/call_ladder.cpp",
        "source/selftest/kernel_services.cpp",
        "source/selftest/debug_ladder.cpp",
        "source/selftest/flash_stream.cpp",
        "source/selftest/handler_binding.cpp",
        "source/selftest/memory_ladder.cpp",
        "source/selftest/multicore.cpp",
        "source/selftest/stream_ladder.cpp",
        "source/selftest/stress.cpp",
        "source/selftest/thread_ladder.cpp",
        "source/selftest/unprivileged.cpp",
        "source/selftest/rp2350_u_cost.cpp",
    ],
    visibility = ["//visibility:public"],
    # flash_stream はカーネルの stream と flash_ops / flash_map を直接試す (FlashFS は使わない)。
    # stress はオブジェクト (peripherals) を相手に試す。
    deps = [
        ":kernel_object",
        "//modules/pico_sdk_support/objects:flash_layout",
        "//modules/pico_sdk_support/objects:flash_ops",
        "//modules/pico_sdk_support/objects:peripherals",
    ],
)

# ESP32-C5 向けの名前付きカーネルアーカイブ (C6 の shizuku_kernel と同形)。
# ★--config=esp32c5 でだけ解決される (board=esp32_c5)。selftest は C6 と同じ 5 ladder の部分集合。
cc_library(
    name = "shizuku_kernel_c5",
    copts = RV_KERNEL_COPTS,
    srcs = KERNEL_SRCS + KERNEL_OBJECT_SRCS + C5_SELFTEST_SRCS + [
        "source/memory_manager/freestanding.cpp",
        "//modules/esp_idf_support/c5:early_boot.cpp",
        "//modules/esp_idf_support/c5:link_stubs.cpp",
        "//chips/esp32_c5:trap.cpp",
        "//boards/esp32_c5:board_esp32_c5.cpp",
        "//boards/esp32_c5:board_esp32_c5_stubs.cpp",
        "//chips/esp32_c5:c5_vectors.S",
        "//chips/esp32_c5:selftest_adapter.cpp",
        "//modules/esp_idf_support/c5:selftest_runner.cpp",
    ],
    target_compatible_with = ["@platforms//cpu:riscv32"],
    visibility = ["//visibility:public"],
    deps = [
        ":internal_headers",
        "//configs:config",
        "//arch/riscv:pmp",
        "//chips/esp32_c5:headers",
        "//boards/esp32_c5:headers",
    ],
)

# Minimal C5 BLE controller-init archive: keep the same kernel/object/trap
# implementation, but omit the C5 selftest ladders and their record runner.
cc_library(
    name = "shizuku_kernel_c5_ble",
    copts = RV_KERNEL_COPTS,
    srcs = KERNEL_SRCS + KERNEL_OBJECT_SRCS + [
        "source/memory_manager/freestanding.cpp",
        "//modules/esp_idf_support/c5:early_boot.cpp",
        "//modules/esp_idf_support/c5:link_stubs.cpp",
        "//chips/esp32_c5:trap.cpp",
        "//boards/esp32_c5:board_esp32_c5.cpp",
        "//boards/esp32_c5:board_esp32_c5_stubs.cpp",
        "//chips/esp32_c5:c5_vectors.S",
    ],
    target_compatible_with = ["@platforms//cpu:riscv32"],
    visibility = ["//visibility:public"],
    deps = [
        ":internal_headers",
        "//configs:config",
        "//arch/riscv:pmp",
        "//chips/esp32_c5:headers",
        "//boards/esp32_c5:headers",
    ],
)


# ESP32-C6 向けの**名前付きカーネルアーカイブ** (libshizuku_kernel.a)。
# カーネル本体 + freestanding メモリマネージャ + pre-init ROM 起動表示 + C6 の未実装 trap stub。
# ★//modules/esp_idf_support/firmware:esp32c6 が ESP-IDF の最終リンクへ渡す。--config=esp32c6 でだけ解決される。
cc_library(
    name = "shizuku_kernel",
    copts = RV_KERNEL_COPTS,
    srcs = KERNEL_SRCS + KERNEL_OBJECT_SRCS + C6_SELFTEST_SRCS + [
        "source/selftest/call_cost.cpp",
        "source/memory_manager/freestanding.cpp",
        "//modules/esp_idf_support/c6:early_boot.cpp",
        "//modules/esp_idf_support/c6:link_stubs.cpp",
        "//chips/esp32_c6:trap.cpp",
        "//boards/esp32_c6:board_esp32_c6.cpp",
        "//boards/esp32_c6:board_esp32_c6_stubs.cpp",
        "//chips/esp32_c6:c6_vectors.S",
        "//chips/esp32_c6:selftest_adapter.cpp",
        "//modules/esp_idf_support/c6:selftest_runner.cpp",
    ],
    target_compatible_with = ["@platforms//cpu:riscv32"],
    visibility = ["//visibility:public"],
    deps = [
        ":internal_headers",
        "//configs:config",
        "//arch/riscv:pmp",
        "//chips/esp32_c6:headers",
        "//boards/esp32_c6:headers",
    ],
)
