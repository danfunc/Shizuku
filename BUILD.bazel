# Shizuku 本体。層構造は docs/03_porting_policy.md §1 を参照。
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# ISA 非依存のカーネルヘッダ (CMake の Shizuku_internal_HEADERS に相当)
cc_library(
    name = "internal_headers",
    hdrs = glob(["internal_headers/**/*.hpp"]),
    includes = ["internal_headers"],
    visibility = ["//visibility:public"],
)

# 書き込み: bazelisk run //:flash (ビルドしてから焼く)。
sh_binary(
    name = "flash",
    srcs = ["tools/flash.sh"],
    data = [":shizuku_uf2"],
)

# ローカルの picotool で ELF → UF2 変換 (.bazelrc のコメント参照。非 hermetic)。
genrule(
    name = "shizuku_uf2",
    srcs = [":shizuku"],
    outs = ["shizuku.uf2"],
    cmd = "/opt/picotool/bin/picotool uf2 convert -t elf $(location :shizuku) $@",
    tags = ["no-sandbox"],
)

cc_binary(
    name = "shizuku",
    srcs = [
        "source/cpu_manager/init.cpp",
        "source/kernel/dispatch.cpp",
        "source/kernel/init.cpp",
        "source/kernel/thread.cpp",
        "source/kernel_object/handler.cpp",
        "source/selftest/call_ladder.cpp",
        "source/selftest/thread_ladder.cpp",
    ],
    deps = [
        ":internal_headers",
        "//configs:config",
        "//modules/pico_sdk_support",
        "@pico-sdk//src/rp2_common/pico_stdlib",
    ],
)
