# ===========================================================================
#  Shizuku — カーネルは**ライブラリ**として提供する
# ===========================================================================
#  実行ファイルを作るのは //firmware だけ。カーネル / カーネルオブジェクト /
#  自己テストはそれぞれ別のライブラリで、「どれを繋いで何を走らせるか」を決めるのは
#  合成 (firmware/main.cpp) の仕事。XNO 側は同じ 3 つを引いて**自分の合成**を書く。
load("@rules_cc//cc:defs.bzl", "cc_library")

# オブジェクト番号の生成。★**CMake とまったく同じスクリプトを呼ぶ** —
# 番号を振る規則を 2 つ持つと、片方だけ直して番号がずれる。名前の一覧も
# objects.list を共有するので、二重に書く場所がどこにも無い (D28)。
genrule(
    name = "object_ids_hpp",
    srcs = [
        "cmake/object_ids.hpp.in",
        "source/apps/objects.list",
        "source/selftest/objects.list",
        "//modules/pico_sdk_support:objects.list",
    ],
    outs = ["generated_object_ids/shizuku/object_ids.hpp"],
    cmd = "python3 $(location //tools:gen_object_ids.py)" +
          " --template $(location cmake/object_ids.hpp.in)" +
          " --out $@ --limit 32" +
          " $(location source/apps/objects.list)" +
          " $(location source/selftest/objects.list)" +
          " $(location //modules/pico_sdk_support:objects.list)",
    tools = ["//tools:gen_object_ids.py"],
)

cc_library(
    name = "object_ids",
    hdrs = [":object_ids_hpp"],
    includes = ["generated_object_ids"],
    visibility = ["//visibility:public"],
)

# ISA 非依存のカーネルヘッダ (CMake の Shizuku_internal_HEADERS に相当)
cc_library(
    name = "internal_headers",
    hdrs = glob(["internal_headers/**/*.hpp"]),
    includes = ["internal_headers"],
    visibility = ["//visibility:public"],
    deps = [":object_ids"],
)

# カーネル = 機構だけの層。★資源を持たない (スレッドの記憶も貸してもらう) ので、
# 実体としてはライブラリ以外になりようがない。
cc_library(
    name = "kernel",
    srcs = [
        "source/cpu_manager/init.cpp",
        "source/kernel/dispatch.cpp",
        "source/kernel/init.cpp",
        "source/kernel/thread.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":internal_headers",
        "//configs:config",
        "//modules/pico_sdk_support:headers",
    ],
)

# カーネルオブジェクト = 方針の層。★カーネルとは別のライブラリにする。分けること
# 自体が D1 (カーネルはオブジェクトを知らない) の検算になる — 依存は一方向しかない。
cc_library(
    name = "kernel_object",
    srcs = [
        "source/kernel_object/handler.cpp",
        "source/kernel_object/memory.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [":kernel"],
)

# アプリ。★いずれ XNO 側へ移す (D17) が、今は動かす場所がここしか無い。
cc_library(
    name = "apps",
    srcs = ["source/apps/thermal.cpp"],
    visibility = ["//visibility:public"],
    deps = [":kernel_object"],
)

# 自己テストは「カーネルの一部」ではなく、カーネルを使うオブジェクトの集合。
cc_library(
    name = "selftest",
    srcs = [
        "source/selftest/call_ladder.cpp",
        "source/selftest/memory_ladder.cpp",
        "source/selftest/multicore.cpp",
        "source/selftest/stream_ladder.cpp",
        "source/selftest/stress.cpp",
        "source/selftest/thread_ladder.cpp",
        "source/selftest/unprivileged.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [":kernel_object"],
)
