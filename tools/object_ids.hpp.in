#ifndef SHIZUKU_OBJECT_IDS_HPP
#define SHIZUKU_OBJECT_IDS_HPP
#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

// Canonical exported C ABI symbol 宣言 (C / C++ 共通)
extern const uintptr_t shizuku_object_id_root;
@SHIZUKU_OBJECT_ID_C_DECLS@
extern const uintptr_t shizuku_object_id_count;

#ifdef __cplusplus
} // extern "C"

namespace shizuku {
namespace object_id {

// C++ 参照 alias (定数参照バインディング、初期化コード不要)
inline constexpr const uintptr_t &root = shizuku_object_id_root;
@SHIZUKU_OBJECT_ID_BODY@
inline constexpr const uintptr_t &count = shizuku_object_id_count;

} // namespace object_id
} // namespace shizuku
#endif // __cplusplus

#endif // SHIZUKU_OBJECT_IDS_HPP
