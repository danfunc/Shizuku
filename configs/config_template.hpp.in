#ifndef SHIZUKU_CONFIG_TEMPLATE_HPP
#define SHIZUKU_CONFIG_TEMPLATE_HPP

${INCLUDE_HEADERS_INSTRUCTION}

#include "shizuku/concepts/arch.hpp"
#include "shizuku/concepts/board.hpp"
#include "shizuku/templates/cpu_manager.hpp"
#include "shizuku/templates/kernel.hpp"
#include "shizuku/templates/kernel_object.hpp"

namespace shizuku{
    using ARCH = ${SHIZUKU_ARCH_TYPE};
    using CHIP = shizuku::chips::${SHIZUKU_CHIP}::chip;
    namespace stream {
        template <typename REC>
        using handle = basic_handle<REC, ::shizuku::ARCH>;
    }
    using BOARD = shizuku::boards::${SHIZUKU_BOARD};
    using CPU_MANAGER = shizuku::templates::cpu_manager<ARCH,CHIP,BOARD,${SHIZUKU_CPU_COUNT}>;
    using MEMORY_MANAGER = ${SHIZUKU_MEMORY_MANAGER};
    using KERNEL = shizuku::templates::kernel<CPU_MANAGER,MEMORY_MANAGER>;
    using KERNEL_OBJECT = shizuku::templates::kernel_object<KERNEL,${SHIZUKU_OBJECT_COUNT},${SHIZUKU_METHOD_COUNT},${SHIZUKU_CALL_DEPTH},${SHIZUKU_THREAD_COUNT}>;
    // An unset configure_file variable yields 0; Bazel substitutes 0 or 1.
    inline constexpr bool xip_cost_probe_enabled = 0${SHIZUKU_XIP_COST_PROBE} != 0;
    inline constexpr bool route_cost_probe_enabled = 0${SHIZUKU_ROUTE_COST_PROBE} != 0;
    // Bytes of padding the RP2350 U-cost tester places in flash code, RAM code and .bss
    // (--//configs:layout_pad_bytes). 0 adds nothing; it only moves addresses.
    inline constexpr unsigned layout_pad_bytes = ${SHIZUKU_LAYOUT_PAD_BYTES};
};

#include "shizuku/svc_ram_instances.hpp"

#endif // SHIZUKU_CONFIG_TEMPLATE_HPP
