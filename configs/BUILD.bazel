# config.hpp の生成 (CMake の configure_file と同じ内容になるよう保つ)。
# TODO(Phase1 以降): 置換値を bazel/config の build setting に外出しする。
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "int_flag", "string_flag")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//configs:kit.bzl", "config_substitutions")
load("//configs:cost_probe_config.bzl", "cost_probe_config")
load(
    "//configs:cyw43_clock.bzl",
    "CYW43_PIO_DIV",
    "CYW43_SCK_ACTUAL_KHZ",
    "CYW43_SPI_PROGRAM",
    "SYS_CLOCK_KHZ",
)

string_flag(
    name = "board",
    build_setting_default = "rp2350_pico2_w",
    values = [
        "rp2040_pico",
        "rp2040_pico_w",
        "rp2040_xiao",
        "rp2350_pico2",
        "rp2350_pico2_w",
        "esp32_c6",
        "esp32_c5",
    ],
    visibility = ["//visibility:public"],
)
string_flag(
    name = "ble_profile",
    build_setting_default = "disabled",
    values = ["disabled", "controller_init"],
    visibility = ["//visibility:public"],
)
# C6 U-mode + PMP (既定 enabled、無効化は --//configs:c6_umode=disabled または --config=c6_umode_off)
string_flag(
    name = "c6_umode",
    build_setting_default = "enabled",
    values = [
        "enabled",
        "disabled",
    ],
    visibility = ["//visibility:public"],
)
config_setting(
    name = "c6_umode_enabled",
    flag_values = {":c6_umode": "enabled"},
    visibility = ["//visibility:public"],
)
config_setting(
    name = "c6_umode_disabled",
    flag_values = {":c6_umode": "disabled"},
    visibility = ["//visibility:public"],
)
config_setting(
    name = "c6_umode_ledger_enabled",
    flag_values = {":c6_umode": "enabled", ":board": "esp32_c6"},
    visibility = ["//visibility:public"],
)
string_flag(
    name = "bootsel_support",
    build_setting_default = "disabled",
    values = ["disabled", "enabled"],
    visibility = ["//visibility:public"],
)
config_setting(
    name = "bootsel_enabled",
    flag_values = {":bootsel_support": "enabled"},
    visibility = ["//visibility:public"],
)
config_setting(
    name = "boot_log_wait_enabled",
    define_values = {"boot_log_wait": "true"},
    visibility = ["//visibility:public"],
)
config_setting(
    name = "flashfs_only_selftest",
    define_values = {"selftest": "flashfs_only"},
    visibility = ["//visibility:public"],
)
config_setting(
    name = "crash_record_enabled",
    define_values = {"crash_record": "true"},
    visibility = ["//visibility:public"],
)
config_setting(
    name = "bt_tlv_ram",
    define_values = {"bt_tlv": "ram"},
    visibility = ["//visibility:public"],
)
selects.config_setting_group(
    name = "rp2040_pico_w_ram_tlv",
    match_all = [":rp2040_pico_w", ":bt_tlv_ram"],
    visibility = ["//visibility:public"],
)
int_flag(
    name = "flash_capacity_bytes",
    build_setting_default = 0,
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2040_pico",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2040"],
    flag_values = {
        ":board": "rp2040_pico",
        "@pico-sdk//bazel/config:PICO_BOARD": "pico",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2040_xiao",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2040"],
    flag_values = {
        ":board": "rp2040_xiao",
        "@pico-sdk//bazel/config:PICO_BOARD": "seeed_xiao_rp2040",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2040_pico_w",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2040"],
    flag_values = {
        ":board": "rp2040_pico_w",
        "@pico-sdk//bazel/config:PICO_BOARD": "pico_w",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2350_pico2",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2350"],
    flag_values = {
        ":board": "rp2350_pico2",
        "@pico-sdk//bazel/config:PICO_BOARD": "pico2",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2350_pico2_w",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2350"],
    flag_values = {
        ":board": "rp2350_pico2_w",
        "@pico-sdk//bazel/config:PICO_BOARD": "pico2_w",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "esp32_c5",
    flag_values = {
        ":board": "esp32_c5",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "esp32_c5_ble",
    flag_values = {
        ":board": "esp32_c5",
        ":ble_profile": "controller_init",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "esp32_c6_ble",
    flag_values = {
        ":board": "esp32_c6",
        ":ble_profile": "controller_init",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "esp32_c6",
    flag_values = {
        ":board": "esp32_c6",
    },
    visibility = ["//visibility:public"],
)
# ★ボード 5 個を毎回列挙しない。select はチップ (rp2040 / rp2350) と
#   CYW43 の有無 (W ボード) の 2 軸で書く。ボードを足したらここだけ直す。
selects.config_setting_group(
    name = "rp2040",
    match_any = [":rp2040_pico", ":rp2040_pico_w", ":rp2040_xiao"],
    visibility = ["//visibility:public"],
)
selects.config_setting_group(
    name = "rp2350",
    match_any = [":rp2350_pico2", ":rp2350_pico2_w"],
    visibility = ["//visibility:public"],
)
# RP2350 のカーネルだけにかける LTO (flag の中身は kernel_lto.bzl)。既定は有効。
bool_flag(
    name = "rp2350_kernel_lto",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2350_kernel_lto_flag_on",
    flag_values = {":rp2350_kernel_lto": "True"},
)
selects.config_setting_group(
    name = "rp2350_kernel_lto_enabled",
    match_all = [":rp2350", ":rp2350_kernel_lto_flag_on"],
    visibility = ["//visibility:public"],
)
# Diagnostic probes are independently opt-in, and only apply to RP2350.
bool_flag(
    name = "rp2350_xip_cost_probe",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)
bool_flag(
    name = "rp2350_route_cost_probe",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)
selects.config_setting_group(
    name = "cyw43",
    match_any = [":rp2040_pico_w", ":rp2350_pico2_w"],
    visibility = ["//visibility:public"],
)

# ★SDK 内部 (cyw43 ドライバ) にも届かせる必要があるので、コンパイルオプションでは
#   なく pico-sdk の PICO_CONFIG_EXTRA_HEADER 経由で入れる。.bazelrc で指している。
expand_template(
    name = "pico_config_extra_headers",
    out = "pico_config_extra_headers.h",
    substitutions = {
        "@DIV@": str(CYW43_PIO_DIV),
        "@PROGRAM@": CYW43_SPI_PROGRAM,
        "@SCK@": str(CYW43_SCK_ACTUAL_KHZ),
        "@CLK@": str(SYS_CLOCK_KHZ),
    },
    template = "pico_config_extra_headers.h.in",
)

cc_library(
    name = "pico_extra_config",
    hdrs = [":pico_config_extra_headers"],
    includes = ["."],
    visibility = ["//visibility:public"],
)

# ★型は SHIZUKU_RP2040 の #if ではなく構成 (select) で決める。どの arch/board を
#   入れたかが config.hpp を開けばそのまま読めるようにするため。
cost_probe_config(
    name = "config_hpp",
    out = "internal_headers/shizuku/config.hpp",
    is_rp2350 = select({":rp2350": True, "//conditions:default": False}),
    xip_probe = ":rp2350_xip_cost_probe",
    route_probe = ":rp2350_route_cost_probe",
    substitutions = select({
        # 型名は歴史的経緯で rp2040_pico_w だが、Pico / Pico W / XIAO 共通の
        # バックエンド (LED の選び方は peripherals.cpp と SDK のボードマクロ側)。
        ":rp2040": config_substitutions("armv6m", "rp2040", "rp2040_pico_w"),
        # Pico 2 / Pico 2 W 共通。CYW43 は W 専用の依存グラフ側にだけ居る。
        ":rp2350": config_substitutions("armv8m", "rp2350", "rp2350_pico2"),
        # ESP32-C6 (未完成・fail-closed)
        ":esp32_c6": config_substitutions("rv32_c6", "esp32_c6", "esp32_c6"),
        # ESP32-C5 (未完成・fail-closed)
        ":esp32_c5": config_substitutions("rv32_c5", "esp32_c5", "esp32_c5"),
        # ESP32-C5 BLE controller-init memory profile; app/selftest profile remains unchanged.
        ":esp32_c5_ble": config_substitutions("rv32_c5", "esp32_c5", "esp32_c5", ble = True),
        ":esp32_c6_ble": config_substitutions("rv32_c6", "esp32_c6", "esp32_c6", ble = True),
    }),
    template = "config_template.hpp.in",
)

cc_library(
    name = "config",
    hdrs = [":config_hpp"],
    includes = ["internal_headers"],
    defines = select({
        ":rp2350": ["SHIZUKU_LEAN_LEDGER=1"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//:internal_headers",
    ] + select({
        ":esp32_c6": ["//chips/esp32_c6:headers", "//boards/esp32_c6:headers"],
        ":esp32_c5": ["//chips/esp32_c5:headers", "//boards/esp32_c5:headers"],
        ":esp32_c5_ble": ["//chips/esp32_c5:headers", "//boards/esp32_c5:headers"],
        ":esp32_c6_ble": ["//chips/esp32_c6:headers", "//boards/esp32_c6:headers"],
        ":rp2040": ["//chips/rp2040:headers", "//modules/pico_sdk_support:headers"],
        ":rp2350": ["//chips/rp2350:headers", "//modules/pico_sdk_support:headers"],
        "//conditions:default": ["//modules/pico_sdk_support:headers"],
    }),
)
