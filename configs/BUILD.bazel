# config.hpp の生成 (CMake の configure_file と同じ内容になるよう保つ)。
# TODO(Phase1 以降): 置換値を bazel/config の build setting に外出しする。
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:common_settings.bzl", "int_flag", "string_flag")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load(
    "//configs:cyw43_clock.bzl",
    "CYW43_PIO_DIV",
    "CYW43_SCK_ACTUAL_KHZ",
    "CYW43_SPI_PROGRAM",
    "SYS_CLOCK_KHZ",
)

string_flag(
    name = "board",
    build_setting_default = "rp2350_pico2_w",
    values = [
        "rp2040_pico",
        "rp2040_pico_w",
        "rp2040_xiao",
        "rp2350_pico2",
        "rp2350_pico2_w",
    ],
    visibility = ["//visibility:public"],
)
int_flag(
    name = "flash_capacity_bytes",
    build_setting_default = 0,
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2040_pico",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2040"],
    flag_values = {
        ":board": "rp2040_pico",
        "@pico-sdk//bazel/config:PICO_BOARD": "pico",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2040_xiao",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2040"],
    flag_values = {
        ":board": "rp2040_xiao",
        "@pico-sdk//bazel/config:PICO_BOARD": "seeed_xiao_rp2040",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2040_pico_w",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2040"],
    flag_values = {
        ":board": "rp2040_pico_w",
        "@pico-sdk//bazel/config:PICO_BOARD": "pico_w",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2350_pico2",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2350"],
    flag_values = {
        ":board": "rp2350_pico2",
        "@pico-sdk//bazel/config:PICO_BOARD": "pico2",
    },
    visibility = ["//visibility:public"],
)
config_setting(
    name = "rp2350_pico2_w",
    constraint_values = ["@pico-sdk//bazel/constraint:rp2350"],
    flag_values = {
        ":board": "rp2350_pico2_w",
        "@pico-sdk//bazel/config:PICO_BOARD": "pico2_w",
    },
    visibility = ["//visibility:public"],
)
selects.config_setting_group(
    name = "rp2040",
    match_any = [":rp2040_pico", ":rp2040_pico_w", ":rp2040_xiao"],
    visibility = ["//visibility:public"],
)

# ★SDK 内部 (cyw43 ドライバ) にも届かせる必要があるので、コンパイルオプションでは
#   なく pico-sdk の PICO_CONFIG_EXTRA_HEADER 経由で入れる。.bazelrc で指している。
expand_template(
    name = "pico_config_extra_headers",
    out = "pico_config_extra_headers.h",
    substitutions = {
        "@DIV@": str(CYW43_PIO_DIV),
        "@PROGRAM@": CYW43_SPI_PROGRAM,
        "@SCK@": str(CYW43_SCK_ACTUAL_KHZ),
        "@CLK@": str(SYS_CLOCK_KHZ),
    },
    template = "pico_config_extra_headers.h.in",
)

cc_library(
    name = "pico_extra_config",
    hdrs = [":pico_config_extra_headers"],
    includes = ["."],
    visibility = ["//visibility:public"],
)

expand_template(
    name = "config_hpp",
    out = "internal_headers/shizuku/config.hpp",
    substitutions = {
        "${INCLUDE_HEADERS_INSTRUCTION}": "\n".join([
        "#if defined(SHIZUKU_RP2040)",
            "#include <shizuku/archs/armv6m.hpp>",
            "#include <shizuku/boards/rp2040_pico_w.hpp>",
            "#else",
            "#include <shizuku/archs/armv8m.hpp>",
            "#include <shizuku/boards/rp2350_pico2.hpp>",
            "#endif",
            "#include <shizuku/memory_managers/pico_sdk.hpp>",
            "#include <shizuku/app_entry.hpp>",
        ]),
        "${SHIZUKU_ARCH}": "armv8m",
        "${SHIZUKU_BOARD}": "rp2350_pico2",
        "${SHIZUKU_CPU_COUNT}": "2",
        "${SHIZUKU_THREAD_COUNT}": "32",
        # ★flight_robocon_telemetory_sender (XNO 役) が別リポジトリから
        #   ble_uart/bno055/bme280 等を足すため 32 では埋まる (Shizuku 自身が
        #   30 使用 + 消費側 2〜3 個で即オーバー、実測: bme280 の CREATE_OBJECT
        #   が範囲外で失敗した)。余裕を持たせておく。
        "${SHIZUKU_OBJECT_COUNT}": "64",
        "${SHIZUKU_METHOD_COUNT}": "16",
        "${SHIZUKU_CALL_DEPTH}": "32",
        "${SHIZUKU_MEMORY_MANAGER}": "shizuku::memory_managers::pico_sdk",
    },
    template = "config_template.hpp.in",
)

cc_library(
    name = "config",
    hdrs = [":config_hpp"],
    includes = ["internal_headers"],
    visibility = ["//visibility:public"],
    deps = [
        "//:internal_headers",
        "//modules/pico_sdk_support:headers",
    ],
)
