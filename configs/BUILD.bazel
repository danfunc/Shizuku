# config.hpp の生成 (CMake の configure_file と同じ内容になるよう保つ)。
# TODO(Phase1 以降): 置換値を bazel/config の build setting に外出しする。
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:defs.bzl", "cc_library")

expand_template(
    name = "config_hpp",
    out = "internal_headers/shizuku/config.hpp",
    substitutions = {
        "${INCLUDE_HEADERS_INSTRUCTION}": "\n".join([
            "#include <shizuku/archs/armv8m.hpp>",
            "#include <shizuku/boards/rp2350_pico2.hpp>",
            "#include <shizuku/memory_managers/pico_sdk.hpp>",
            "#include <shizuku/app_entry.hpp>",
        ]),
        "${SHIZUKU_ARCH}": "armv8m",
        "${SHIZUKU_BOARD}": "rp2350_pico2",
        "${SHIZUKU_CPU_COUNT}": "1",
        "${SHIZUKU_THREAD_COUNT}": "32",
        "${SHIZUKU_MEMORY_MANAGER}": "shizuku::memory_managers::pico_sdk",
    },
    template = "config_template.hpp.in",
)

cc_library(
    name = "config",
    hdrs = [":config_hpp"],
    includes = ["internal_headers"],
    visibility = ["//visibility:public"],
    deps = [
        "//:internal_headers",
        "//modules/pico_sdk_support:headers",
    ],
)
