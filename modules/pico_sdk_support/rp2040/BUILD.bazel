# RP2040 のポート: ARMv6-M の arch (arch/armv6m) + RP2040 の board (boards/rp2040_pico_w)。
# SDK 依存の arch glue (SysTick の診断・watchdog・atomic の spin lock) はここに置く。
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//modules/pico_sdk_support:__subpackages__"])

exports_files(["arch_glue_v6m.cpp"])

filegroup(
    name = "arch_glue_src",
    srcs = ["arch_glue_v6m.cpp"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "arch_glue",
    srcs = ["arch_glue_v6m.cpp"],
    alwayslink = True,
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2040"],
    deps = [
        "//arch/armv6m:headers",
        "//chips/rp2040:headers",
        "//:kernel",
        "//configs:config",
        "//modules/pico_sdk_support/objects:usb_cdc",
        "@pico-sdk//src/rp2_common/hardware_watchdog:hardware_watchdog",
        "@pico-sdk//src/rp2_common/hardware_sync",
        "@pico-sdk//src/rp2_common/pico_multicore",
        "@pico-sdk//src/rp2_common/pico_stdlib",
    ],
    local_defines = select({
        "//configs:crash_record_enabled": [
            "SHIZUKU_CRASH_RECORD=1",
            "SHIZUKU_BOOT_LOG_WAIT=1",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "port",
    alwayslink = True,
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2040"],
    deps = [
        ":arch_glue",
        "//arch/armv6m:ctx",
        "//boards/rp2040_pico_w:board",
        "//boards/rp2040_pico_w:headers",
    ],
)
