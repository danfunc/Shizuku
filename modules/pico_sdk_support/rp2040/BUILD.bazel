# RP2040 のポート: ARMv6-M の arch (arch/armv6m) + RP2040 の board (chips/rp2040)。
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//modules/pico_sdk_support:__subpackages__"])

cc_library(
    name = "port",
    alwayslink = True,
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2040"],
    deps = [
        "//arch/armv6m:ctx",
        "//chips/rp2040:board",
        "//chips/rp2040:headers",
    ],
)
