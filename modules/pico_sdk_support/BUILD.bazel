# ===========================================================================
#  pico_sdk_support — pico-sdk 上のポート (PORT §5 の arch / board / objects)
# ===========================================================================
#  パッケージの割り方 (依存は上から下への一方向):
#
#    //modules/pico_sdk_support          構成が要る最小限 (config.hpp が include する
#                                        ヘッダ・メモリマネージャ・SDK 設定) と、
#                                        全部入りの :pico_sdk_support
#    //modules/pico_sdk_support/rp2040   ARMv6-M の arch + RP2040 の board
#    //modules/pico_sdk_support/rp2350   ARMv8-M の arch + RP2350 の board + gdb_stub
#    //modules/pico_sdk_support/objects  チップ非依存のオブジェクト (1 つ 1 ライブラリ)
#
#  ★チップの選択はここ (:headers / :pico_sdk_support) の select だけで行う。
#    カーネルはポートを名指ししない — //configs:config 経由で型として受け取る。
load("@rules_cc//cc:defs.bzl", "cc_library")

exports_files(["objects.list"])

cc_library(
    name = "btstack_config",
    hdrs = ["config/btstack_config.h"],
    includes = ["config"],
    visibility = ["//visibility:public"],
)

# ★TinyUSB の設定を差し替える (CDC を 2 本にする)。.bazelrc の
#   PICO_TINYUSB_CONFIG がこれを指している。
cc_library(
    name = "tusb_config",
    hdrs = ["tusb_config.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)

# 構成 (config.hpp) が include するヘッダ。★実装とは分けて公開する — config は
# カーネルより前に要るので、ここがカーネルに依存すると循環する。
cc_library(
    name = "headers",
    hdrs = glob(["internal_headers/**/*.hpp"]),
    includes = ["internal_headers"],
    visibility = ["//visibility:public"],
    deps = [
        "//:internal_headers",
    ] + select({
        "//configs:rp2040": ["//modules/pico_sdk_support/rp2040:headers"],
        "//configs:rp2350": ["//modules/pico_sdk_support/rp2350:headers"],
    }),
)

cc_library(
    name = "memory_manager",
    srcs = ["memory_manager.cpp"],
    # ★カーネル (libkernel.a) から引かれるが、こちらはカーネルに依存しないので
    #   リンク順でカーネルより前に並びうる。落とされないよう常に含める。
    alwayslink = True,
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

cc_library(
    name = "arch_glue",
    srcs = ["arch_glue.cpp"],
    alwayslink = True,
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        "//:kernel",
        "//configs:config",
    ],
)

# 全部入り: firmware が引くのはこれ 1 つ。XNO 側は必要な部品だけを個別に引いてよい。
# ★alwayslink: 例外ベクタから引かれるだけで、C++ 側から参照の無いシンボル
#   (ISA の入口) や、TinyUSB の weak コールバックの上書きがあるので、参照が
#   無くてもリンクに含める。部品側もそれぞれ alwayslink にしてある。
cc_library(
    name = "pico_sdk_support",
    alwayslink = True,
    visibility = ["//visibility:public"],
    deps = [
        ":arch_glue",
        ":memory_manager",
        "//modules/pico_sdk_support/objects:flash_fs",
        "//modules/pico_sdk_support/objects:flash_layout_limit",
        "//modules/pico_sdk_support/objects:peripherals",
        "//modules/pico_sdk_support/objects:usb_cdc",
    ] + select({
        "//configs:rp2040": ["//modules/pico_sdk_support/rp2040:port"],
        "//configs:rp2350": [
            "//modules/pico_sdk_support/rp2350:gdb_stub",
            "//modules/pico_sdk_support/rp2350:port",
        ],
    }),
)

# 旧ラベルの互換 (分割前に //modules/pico_sdk_support:ble_uart / :ota を
# 引いていた側 = XNO 役のリポジトリを壊さないため)。
alias(
    name = "ble_uart",
    actual = "//modules/pico_sdk_support/objects:ble_uart",
    visibility = ["//visibility:public"],
)

alias(
    name = "ota",
    actual = "//modules/pico_sdk_support/objects:ota",
    visibility = ["//visibility:public"],
)
