load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# ESP-IDF の Wi-Fi / BLE blob 用 OSI 部品 (設計: /private/tmp/shizuku-v3-design/esp32_ble_wifi.typ)。
# FreeRTOS 互換層ではなく、osi 表が要求する同期部品だけ。PORT を差し替えられるので
# ホストで単体テストできる。実機側の PORT (object_api syscall) は未実装。
cc_library(
    name = "osi_sync",
    srcs = ["osi_sync_check.cpp"],
    hdrs = ["osi_sync.hpp"],
    includes = ["."],
)

cc_library(
    name = "c5_intr_alloc",
    srcs = ["c5_intr_alloc.cpp"],
    hdrs = ["//chips/esp32_c5:trap_api.hpp"],
    includes = ["."],
    deps = [":osi_sync", "//chips/esp32_c5:headers"],
)

# ホスト単体テスト (Bazel の既定 platform は arm 向けなので cc_test にはしない):
#   c++ -std=c++20 -o /tmp/osi_sync_test modules/esp_idf_support/radio/osi_sync_test.cpp && /tmp/osi_sync_test
exports_files(["osi_sync.hpp", "osi_sync_test.cpp", "c5_intr_alloc.cpp", "c5_libc_lock_diag.cpp"])
