package(default_visibility = ["//visibility:public"])

config_setting(
    name = "c5_ble_prefer_1m_phy",
    define_values = {"SHIZUKU_C5_BLE_PREFER_1M_PHY": "1"},
)
config_setting(
    name = "esp_ble_prefer_1m_phy",
    define_values = {"SHIZUKU_ESP_BLE_PREFER_1M_PHY": "1"},
)
config_setting(
    name = "esp_ota_enabled",
    define_values = {"esp_ota": "on"},
)
config_setting(
    name = "esp_ota_test_writes_enabled",
    define_values = {"esp_ota_test_writes": "on"},
)

exports_files(["main/early_diag.c"])

# ESP32-C6: Bazel が作る libshizuku_kernel.a を ESP-IDF v6.1 の最終リンクへ渡し、
# .bin を出すターゲット (idf.py build の薄いラッパ)。
#   bazelisk build --config=esp32c6 //modules/esp_idf_support/firmware:esp32c6
genrule(
    name = "esp32c6",
    srcs = [
        "//:shizuku_kernel",
        ":esp32c6_project",
    ],
    outs = ["shizuku_esp32c6.bin"],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel); do case $$f in *libshizuku_kernel.a) ARCHIVE=$$f;; esac; done;" +
          " $(location build.sh) $$ARCHIVE $@ esp-15.2.0_20251204",
    tools = ["build.sh"],
    tags = [
        "local",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

# ESP32-C5: BLE profile builds the NimBLE GATT advertiser using its isolated sdkconfig.
#   bazelisk build --config=esp32c5 //modules/esp_idf_support/firmware:esp32c5
genrule(
    name = "esp32c5",
    srcs = [
        "//:shizuku_kernel_c5",
        ":esp32c6_project",
    ],
    outs = ["shizuku_esp32c5.bin"],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel_c5); do case $$f in *libshizuku_kernel_c5.a) ARCHIVE=$$f;; esac; done;" +
          " $(location build.sh) $$ARCHIVE $@ esp-15.2.0_20251204 esp32c5",
    tools = ["build.sh"],
    tags = [
        "local",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

# Set --define=SHIZUKU_C5_BLE_PREFER_1M_PHY=1 to compile the BLE image with a
# 1M PHY preference; the default is 0 and does not request 1M.
genrule(
    name = "esp32c5_ble",
    srcs = [
        "//:shizuku_kernel_c5_ble",
        ":esp32c6_project",
    ],
    outs = ["shizuku_esp32c5_ble.bin", "shizuku_esp32c5_ble.elf", "shizuku_esp32c5_ble.map"],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel_c5_ble); do case $$f in *libshizuku_kernel_c5_ble.a) ARCHIVE=$$f;; esac; done;" +
          select({
              ":c5_ble_prefer_1m_phy": "SHIZUKU_ESP_BLE_PREFER_1M_PHY=1 ",
              "//conditions:default": "SHIZUKU_ESP_BLE_PREFER_1M_PHY=0 ",
          }) +
          " $(location build.sh) $$ARCHIVE $(location shizuku_esp32c5_ble.bin) esp-15.2.0_20251204 esp32c5 ble $(location shizuku_esp32c5_ble.elf) $(location shizuku_esp32c5_ble.map)",
    tools = ["build.sh"],
    tags = ["local", "no-sandbox"],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

genrule(
    name = "esp32c6_ble",
    srcs = ["//:shizuku_kernel", ":esp32c6_project"],
    outs = ["shizuku_esp32c6_ble.bin", "shizuku_esp32c6_ble.elf", "shizuku_esp32c6_ble.map"],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel); do case $$f in *libshizuku_kernel.a) ARCHIVE=$$f;; esac; done;" +
          select({
              ":esp_ble_prefer_1m_phy": "SHIZUKU_ESP_BLE_PREFER_1M_PHY=1 ",
              "//conditions:default": "SHIZUKU_ESP_BLE_PREFER_1M_PHY=0 ",
          }) +
          " $(location build.sh) $$ARCHIVE $(location shizuku_esp32c6_ble.bin) esp-15.2.0_20251204 esp32c6 ble $(location shizuku_esp32c6_ble.elf) $(location shizuku_esp32c6_ble.map)",
    tools = ["build.sh"],
    tags = ["local", "no-sandbox"],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

# Opt-in C6 OTA image and complete boot/partition/config evidence bundle.
# Build with --define=esp_ota=on; the normal C6 BLE target stays unchanged.
genrule(
    name = "esp32c6_ble_ota",
    srcs = ["//:shizuku_kernel", ":esp32c6_project",
            "//modules/esp_idf_support/ble_ota:component_sources"],
    outs = [
        "shizuku_esp32c6_ble_ota.bin",
        "shizuku_esp32c6_ble_ota.elf",
        "shizuku_esp32c6_ble_ota.map",
        "shizuku_esp32c6_ble_ota.sdkconfig",
        "shizuku_esp32c6_ble_ota.bootloader.bin",
        "shizuku_esp32c6_ble_ota.partition-table.bin",
        "shizuku_esp32c6_ble_ota.partition-table.csv",
        "shizuku_esp32c6_ble_ota.manifest.json",
    ],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel); do case $$f in *libshizuku_kernel.a) ARCHIVE=$$f;; esac; done;" +
          select({
              ":esp_ota_enabled": "",
              "//conditions:default": "echo 'ERROR: use --define=esp_ota=on' >&2; exit 2; ",
          }) +
          select({
              ":esp_ota_test_writes_enabled": "SHIZUKU_ESP_OTA_TEST_WRITES=1 ",
              "//conditions:default": "",
          }) +
          " bash $(location build_ota_profile.sh) $(location build.sh) $(location collect_ota_artifacts.py) $$ARCHIVE " +
          "$(location shizuku_esp32c6_ble_ota.bin) $(location shizuku_esp32c6_ble_ota.elf) $(location shizuku_esp32c6_ble_ota.map) " +
          "$(location shizuku_esp32c6_ble_ota.sdkconfig) $(location shizuku_esp32c6_ble_ota.bootloader.bin) " +
          "$(location shizuku_esp32c6_ble_ota.partition-table.bin) $(location shizuku_esp32c6_ble_ota.partition-table.csv) " +
          "$(location shizuku_esp32c6_ble_ota.manifest.json)",
    tools = ["build.sh", "build_ota_profile.sh", "collect_ota_artifacts.py"],
    tags = ["local", "no-sandbox"],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

filegroup(
    name = "esp32c6_project",
    srcs = glob(["CMakeLists.txt", "sdkconfig.defaults", "sdkconfig.defaults.esp32c5", "sdkconfig.defaults.esp32c5.ble", "sdkconfig.defaults.esp32c6.ble", "esp32c6_ota_defaults.conf", "partitions_esp32c6_ota.csv", "main/*"]) + [
        "//modules/esp_idf_support/radio:c5_intr_alloc.cpp",
        "//modules/esp_idf_support/radio:c6_intr_alloc.cpp",
        "//modules/esp_idf_support/radio:intr_alloc_impl.inc",
        "//modules/esp_idf_support/radio:ble_chip.hpp",
        "//modules/esp_idf_support/radio:ble_chip_c5.cpp",
        "//modules/esp_idf_support/radio:ble_chip_c6.cpp",
        "//modules/esp_idf_support/radio:c5_libc_lock_diag.cpp",
        "//modules/esp_idf_support/radio:osi_sync.hpp",
        "//chips/esp32_c5:trap_api.hpp",
        "//chips/esp32_c6:trap_api.hpp",
        "//modules/esp_idf_support/freertos_compat:compat.cpp",
        "//modules/esp_idf_support/freertos_compat:freertos_api.cpp",
        "//modules/esp_idf_support/freertos_compat:shizuku_port.cpp",
        "//modules/esp_idf_support/freertos_compat:compat.hpp",
        "//modules/esp_idf_support/freertos_compat:shizuku_port.hpp",
        "//modules/esp_idf_support/freertos_compat:freertos_headers",
        "//:esp_idf_support_headers",
    ],
)
