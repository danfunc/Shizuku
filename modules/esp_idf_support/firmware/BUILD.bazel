package(default_visibility = ["//visibility:public"])

config_setting(
    name = "c5_ble_prefer_1m_phy",
    define_values = {"SHIZUKU_C5_BLE_PREFER_1M_PHY": "1"},
)
config_setting(
    name = "esp_ble_prefer_1m_phy",
    define_values = {"SHIZUKU_ESP_BLE_PREFER_1M_PHY": "1"},
)
# --config=kernel_lto (.bazelrc): カーネルの .o を `-flto -ffat-lto-objects` でコンパイルし、
# カーネル .a を作る段階で 1 回だけ LTO をかける (shizuku_kernel_lto)。
config_setting(
    name = "kernel_lto",
    define_values = {"shizuku_kernel_lto": "1"},
)
exports_files([
    "main/early_diag.c",
    "build.sh",
    "kernel_lto.sh",
    "build_ota_profile.sh",
    "collect_ota_artifacts.py",
])

sh_test(
    name = "test_build_env_fixture",
    srcs = ["test_build_env_fixture.py"],
    data = [
        "build.sh",
        "build_ota_profile.sh",
        "collect_ota_artifacts.py",
        "//modules/esp_idf_support/ble_ota:esp_component_sources",
    ],
)

# カーネルの .a を作る段階で 1 回だけ LTO をかけた .a (--config=kernel_lto のときだけ esp32c6 が使う)。
#   Bazel の rv32_esp ツールチェーンの GCC (コンパイルと同じ版) で部分リンクする。
#   bazelisk build --config=esp32c6 --config=kernel_lto //modules/esp_idf_support/firmware:shizuku_kernel_lto
genrule(
    name = "shizuku_kernel_lto",
    srcs = ["//:shizuku_kernel"],
    outs = ["libshizuku_kernel_lto.a"],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel); do case $$f in *libshizuku_kernel.a) ARCHIVE=$$f;; esac; done;" +
          " $(location kernel_lto.sh) \"$(CC)\" \"$(AR)\" \"$(NM)\" $$ARCHIVE $@",
    tools = [
        "kernel_lto.sh",
        "@bazel_tools//tools/cpp:current_cc_toolchain",
    ],
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

# ESP32-C6: Bazel が作る libshizuku_kernel.a を ESP-IDF v6.1 の最終リンクへ渡し、
# .bin を出すターゲット (idf.py build の薄いラッパ)。
#   bazelisk build --config=esp32c6 //modules/esp_idf_support/firmware:esp32c6
genrule(
    name = "esp32c6",
    srcs = select({
        ":kernel_lto": [":shizuku_kernel_lto"],
        "//conditions:default": ["//:shizuku_kernel"],
    }) + [":esp32c6_project"],
    outs = ["shizuku_esp32c6.bin"],
    cmd = "ARCHIVE=; for f in $(SRCS); do case $$f in *libshizuku_kernel.a|*libshizuku_kernel_lto.a) ARCHIVE=$$f;; esac; done;" +
          " $(location build.sh) $$ARCHIVE $@ esp-15.2.0_20251204",
    tools = ["build.sh"],
    tags = [
        "local",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

# ESP32-C5: BLE profile builds the NimBLE GATT advertiser using its isolated sdkconfig.
#   bazelisk build --config=esp32c5 //modules/esp_idf_support/firmware:esp32c5
genrule(
    name = "esp32c5",
    srcs = [
        "//:shizuku_kernel_c5",
        ":esp32c6_project",
    ],
    outs = ["shizuku_esp32c5.bin"],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel_c5); do case $$f in *libshizuku_kernel_c5.a) ARCHIVE=$$f;; esac; done;" +
          " $(location build.sh) $$ARCHIVE $@ esp-15.2.0_20251204 esp32c5",
    tools = ["build.sh"],
    tags = [
        "local",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

# Set --define=SHIZUKU_C5_BLE_PREFER_1M_PHY=1 to compile the BLE image with a
# 1M PHY preference; the default is 0 and does not request 1M.
genrule(
    name = "esp32c5_ble",
    srcs = [
        "//:shizuku_kernel_c5_ble",
        ":esp32c6_project",
    ],
    outs = ["shizuku_esp32c5_ble.bin", "shizuku_esp32c5_ble.elf", "shizuku_esp32c5_ble.map"],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel_c5_ble); do case $$f in *libshizuku_kernel_c5_ble.a) ARCHIVE=$$f;; esac; done;" +
          select({
              ":c5_ble_prefer_1m_phy": "SHIZUKU_ESP_BLE_PREFER_1M_PHY=1 ",
              "//conditions:default": "SHIZUKU_ESP_BLE_PREFER_1M_PHY=0 ",
          }) +
          " $(location build.sh) $$ARCHIVE $(location shizuku_esp32c5_ble.bin) esp-15.2.0_20251204 esp32c5 ble $(location shizuku_esp32c5_ble.elf) $(location shizuku_esp32c5_ble.map)",
    tools = ["build.sh"],
    tags = ["local", "no-sandbox"],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

genrule(
    name = "esp32c6_ble",
    srcs = ["//:shizuku_kernel", ":esp32c6_project"],
    outs = ["shizuku_esp32c6_ble.bin", "shizuku_esp32c6_ble.elf", "shizuku_esp32c6_ble.map"],
    cmd = "ARCHIVE=; for f in $(locations //:shizuku_kernel); do case $$f in *libshizuku_kernel.a) ARCHIVE=$$f;; esac; done;" +
          select({
              ":esp_ble_prefer_1m_phy": "SHIZUKU_ESP_BLE_PREFER_1M_PHY=1 ",
              "//conditions:default": "SHIZUKU_ESP_BLE_PREFER_1M_PHY=0 ",
          }) +
          " $(location build.sh) $$ARCHIVE $(location shizuku_esp32c6_ble.bin) esp-15.2.0_20251204 esp32c6 ble $(location shizuku_esp32c6_ble.elf) $(location shizuku_esp32c6_ble.map)",
    tools = ["build.sh"],
    tags = ["local", "no-sandbox"],
    target_compatible_with = ["@platforms//cpu:riscv32"],
)

