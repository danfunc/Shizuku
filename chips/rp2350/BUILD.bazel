load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = ["rp2350_pico2.hpp"],
    includes = ["."],
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2350"],
    deps = [
        "//arch/armv8m:headers",
        "//:internal_headers",
        "@pico-sdk//src/rp2_common/hardware_sync",
        "@pico-sdk//src/rp2_common/pico_stdlib",
    ],
)

cc_library(
    name = "board",
    srcs = ["board.cpp"],
    alwayslink = True,
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2350"],
    deps = [
        ":headers",
        "//arch/armv8m:ctx",
        "//:kernel",
        "//configs:config",
        "//modules/pico_sdk_support/objects:usb_cdc",
        "@pico-sdk//bazel/config:PICO_TINYUSB_LIB",
        "@pico-sdk//src/rp2_common/hardware_dma",
        "@pico-sdk//src/rp2_common/hardware_exception",
        "@pico-sdk//src/rp2_common/hardware_sync",
        "@pico-sdk//src/rp2_common/hardware_watchdog",
        "@pico-sdk//src/rp2_common/pico_multicore",
        "@pico-sdk//src/rp2_common/pico_stdlib",
    ],
)
