# Shizuku — Bazel ビルド (docs/03_porting_policy.md D15)
# pico-sdk は公式 Bazel サポート (2.0+) を使う (BCR の 2.2.0)。
module(
    name = "shizuku",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "0.0.9")
bazel_dep(name = "bazel_skylib", version = "1.6.1")
bazel_dep(name = "rules_cc", version = "0.0.10")
bazel_dep(name = "pico-sdk", version = "2.2.0")

# pico-sdk のツールチェーンは dev_dependency 登録なので、利用側が明示的に登録する。
register_toolchains(
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2040",
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2350",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2040",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2040",
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-aarch64-rp2040",
    "@pico-sdk//bazel/toolchain:linux-aarch64-rp2350",
)

# OTA は XNO (xno::ota) が持つ。ルートの firmware (= アプリの合成) だけが引く。
# XNO は逆に @shizuku の公開ターゲットへ依存する (モジュール循環)。ターゲットの
# 循環は無い (@xno//objects/ota -> @shizuku kernel/ble_uart/flash_layout、
# @shizuku 側の部品は ota を引かない)。
# 利用者向けに固定する SHA はまだ無い (XNO 側が未 push) ので、ローカルの
# ワークツリーを指す。
bazel_dep(name = "xno", version = "0.1.0", dev_dependency = True)

local_path_override(
    module_name = "xno",
    path = "../XNO-ota",
)
