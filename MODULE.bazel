# Shizuku — Bazel ビルド (docs/03_porting_policy.md D15)
# pico-sdk は公式 Bazel サポート (2.0+) を使う (BCR の 2.2.0)。
module(
    name = "shizuku",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "0.0.9")
bazel_dep(name = "bazel_skylib", version = "1.6.1")
bazel_dep(name = "rules_cc", version = "0.0.10")
bazel_dep(name = "pico-sdk", version = "2.2.0")

# pico-sdk のツールチェーンは dev_dependency 登録なので、利用側が明示的に登録する。
register_toolchains(
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2040",
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2350",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2040",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2040",
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-aarch64-rp2040",
    "@pico-sdk//bazel/toolchain:linux-aarch64-rp2350",
)

# ESP32-C6 (RV32) 用ツールチェーン。★ESP-IDF v6.1 の tools.json が指す
# riscv32-esp-elf esp-15.2.0_20251204 と**同一のアーカイブ** (url / sha256 / size) を
# 引く。Bazel と IDF のコンパイラが食い違うと同じ .a を別の ABI 前提でリンクして
# しまうので、バージョンは //toolchains/rv32_esp のテストで突き合わせる。
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "riscv32_esp_elf_gcc",
    build_file = "//toolchains/rv32_esp:gcc.BUILD",
    sha256 = "0869d1083532c631808543dd802885f02dbe1bb3bd640be0dee827e82ded768d",
    strip_prefix = "riscv32-esp-elf",
    urls = ["https://github.com/espressif/crosstool-NG/releases/download/esp-15.2.0_20251204/riscv32-esp-elf-15.2.0_20251204-aarch64-apple-darwin.tar.xz"],
)

register_toolchains("//toolchains/rv32_esp:rv32_esp_toolchain")
