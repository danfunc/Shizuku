{
  // ★ボタンの整理 (2026-08-21):
  //   ・ステップ実行 = VS Code 標準の「Run and Debug」パネル (F5 / 緑の ▶)。
  //     設定は .vscode/launch.json。第三者拡張は要らない
  //   ・焼くだけ = Cmd+Shift+B (tasks.json の既定ビルドタスク)
  //   下の設定は「焼く」をステータスバーにも出したい人向けの**任意**。
  //   拡張 (spencerwmiles.vscode-task-buttons) が無ければ無視されるだけ。
  "VsCodeTaskButtons.showCounter": false,
  "VsCodeTaskButtons.tasks": [
    { "label": "$(zap) 焼く", "task": "Shizuku: 焼く", "tooltip": "bazelisk run //firmware:flash" },
    { "label": "$(tools) ビルド", "task": "Shizuku: ビルド", "tooltip": "bazelisk build //firmware:shizuku_uf2" },
    { "label": "$(plug) シリアル", "task": "Shizuku: シリアルを見る", "tooltip": "自己テストと [STRESS] の報告を読む" }
  ],
  // ビルドは Bazel なので、Pico 拡張の CMake 自動設定は止めておく
  // (走らせると CMakeLists.txt が無いと言って騒ぐだけになる)。
  "cmake.configureOnOpen": false,
  "cmake.automaticReconfigure": false
}
