{
  // ===========================================================================
  //  Shizuku のビルドは Bazel (docs/03_porting_policy.md D15 / D38)
  // ===========================================================================
  //  ★Cmd+Shift+B (Windows/Linux: Ctrl+Shift+B) が「焼く」に割り当ててある。
  //    一覧から選ぶなら Terminal → Run Task。
  //  ★ステータスバーに**本物のボタン**を出したい場合は
  //    spencerwmiles.vscode-task-buttons を入れる (.vscode/extensions.json で
  //    推奨に入れてある)。設定は .vscode/settings.json 側。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Shizuku: 焼く",
      "detail": "bazelisk run //firmware:flash — ビルドして書き込み、USB が戻るまで待つ",
      "type": "shell",
      // ★★焼いたあと**シリアルが戻るまで待つ**のが必須 (2026-08-24 実測)。
      //   picotool が終了した時点では USB はまだ再列挙されておらず、
      //   デバイスノードは **約 2.8 秒** 消えたままになる
      //   (実測: t=+6.0s に消え、t=+8.8s に戻った)。ここで待たないと、
      //   このタスクを preLaunchTask にしている F5 (launch.json) が
      //   「まだ存在しないポート」を開きに行き、
      //     Unable to start debugging. ... could not open device:
      //     No such file or directory
      //   で落ちる。**焼けていないのではなく、戻る前に掴みに行っただけ**。
      //   ★消えるのを待ってから戻るのを待つ (2 段構え)。消えるのを待たずに
      //     「今ある」で判定すると、**再列挙前の古いノードを見て即通過**して
      //     しまい、結局同じところで落ちる。
      "command": "tools/flash_and_wait.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Shizuku: ビルド",
      "detail": "bazelisk build //firmware:shizuku_uf2 — 焼かずに作るだけ",
      "type": "shell",
      "command": "bazelisk build //firmware:shizuku_uf2",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Shizuku: シリアルを見る",
      "detail": "自己テストと [STRESS] の報告を読む (Ctrl+C で抜ける)",
      "type": "shell",
      "command": "for i in $(seq 1 20); do port=$(ls /dev/cu.usbmodem* 2>/dev/null | head -1); [ -n \"$port\" ] && break; sleep 1; done; if [ -z \"$port\" ]; then echo 'シリアルが出てこない (ファームが固まっている可能性)'; exit 1; fi; echo \"--- $port ---\"; cat \"$port\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Shizuku: 掃除",
      "detail": "bazelisk clean — 出力を捨てる (依存の取り直しは clean --expunge)",
      "type": "shell",
      "command": "bazelisk clean",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
