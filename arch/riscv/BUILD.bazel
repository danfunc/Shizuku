load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "frame_layout.h",
    "pmp.hpp",
    "rv32_trap.S",
])

cc_library(
    name = "pmp",
    hdrs = [
        "frame_layout.h",
        "pmp.hpp",
        "trap_route.hpp",
    ],
    includes = ["."],
)

cc_test(
    name = "pmp_test",
    srcs = [
        "pmp.hpp",
        "test_pmp.cpp",
    ],
    copts = ["-std=c++20"],
    includes = ["."],
)

cc_test(
    name = "trap_route_test",
    srcs = ["test_trap_route.cpp"],
    copts = ["-std=c++20"],
    deps = [
        ":pmp",
        "//chips/esp32_c6:headers",
        "//:internal_headers",
    ],
)
