load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pmp.hpp",
    "rv32.hpp",
    "rv32_frame.h",
    "rv32_trap.S",
])

cc_library(
    name = "rv32",
    hdrs = [
        "rv32.hpp",
        "rv32_frame.h",
        "rv32_trap.S",
    ],
    includes = ["."],
    deps = [
        ":pmp",
        "//:arch_headers",
    ],
)

cc_library(
    name = "pmp",
    hdrs = [
        "pmp.hpp",
        "trap_route.hpp",
    ],
    includes = ["."],
)

cc_test(
    name = "pmp_test",
    srcs = [
        "pmp.hpp",
        "test_pmp.cpp",
    ],
    copts = ["-std=c++20"],
    includes = ["."],
)
