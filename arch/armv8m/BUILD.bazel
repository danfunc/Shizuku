load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = ["armv8m.hpp"],
    includes = ["."],
    deps = [
        "//arch:ppb",
        "//:arch_headers",
    ],
)

# MPU レジスタに触らず、窓の前計算値と戻り先の権威 (台帳) だけを host で縛る。
cc_test(
    name = "object_window_test",
    srcs = ["object_window_test.cpp"],
    deps = [
        ":headers",
        "//:internal_headers",
    ],
)

# 文脈退避・復帰・戻り口の asm のみ。C++ のフック (systick / svc / fault など) の実体は
# modules/pico_sdk_support/rp2350 にある (SDK 依存をここに置かない)。
cc_library(
    name = "ctx",
    srcs = ["armv8m_ctx.S"],
    alwayslink = True,
)
